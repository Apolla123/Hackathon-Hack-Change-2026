LLM_API_URL=https://example.invalid/v1
LLM_API_KEY=
LLM_MODEL=Qwen3.8-27B
# 1 = попросить сервер не включать «размышления» модели (быстрее), если API это поддерживает
LLM_DISABLE_THINKING=0
LLM_TIMEOUT=45

# По умолчанию берутся LLM_API_URL / LLM_API_KEY
EMBED_API_URL=
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3

# Поиск
TOP_K=4
MIN_CONFIDENCE=0.30

# Сервер
PORT=8000
# Домен сайта Energytool, если виджет встроен на другом домене (для CORS)
CORS_ORIGIN=
# Необязательно: куда POST-ом отправлять готовые заявки (CRM / почтовый шлюз)
LEAD_WEBHOOK_URL=
